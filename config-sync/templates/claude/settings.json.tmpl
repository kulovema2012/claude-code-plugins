{
  "skillListingBudgetFraction": 0.025,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_FORK_SUBAGENT": "1",
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "64000"
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "model": "fable",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "C:/WINDOWS/System32/WindowsPowerShell/v1.0/powershell.exe",
            "args": [
              "-NoProfile",
              "-NonInteractive",
              "-Command",
              "(New-Object System.Media.SoundPlayer '{{HOME}}/.claude/notify-sounds/permission-require-pcm.wav').PlaySync()"
            ],
            "timeout": 10,
            "statusMessage": "Playing permission sound...",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Program Files/nodejs/node.exe",
            "args": [
              "{{HOME}}/.claude/hooks/ta{{CLAUDE_API_KEY}}.mjs"
            ],
            "timeout": 30,
            "statusMessage": "Playing task complete sound...",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\WINDOWS\\System32\\cmd.exe",
            "args": [
              "/d",
              "/c",
              "{{HOME}}/.orca/agent-hooks/claude-hook.cmd"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '{{HOME}}/.orca/agent-hooks/claude-hook.cmd' ]; then '{{HOME}}/.orca/agent-hooks/claude-hook.cmd'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Program Files/nodejs/node.exe",
            "args": [
              "{{HOME}}/.claude/hooks/warp-autoswitch.mjs"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Program Files/nodejs/node.exe",
            "args": [
              "{{HOME}}/.claude/hooks/context-mode-cache-heal.mjs"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Program Files/nodejs/node.exe",
            "args": [
              "{{HOME}}/.claude/hooks/apply-skill-overrides.mjs"
            ],
            "timeout": 30,
            "statusMessage": "Applying skill overrides..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Program Files/nodejs/node.exe\" \"{{HOME}}/.claude/hooks/context-mode-cache-heal.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Program Files/nodejs/node.exe",
            "args": [
              "{{HOME}}/.claude/hooks/gitnexus/gitnexus-hook.cjs"
            ],
            "timeout": 10,
            "statusMessage": "Enriching with GitNexus graph context..."
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\WINDOWS\\System32\\cmd.exe",
            "args": [
              "/d",
              "/c",
              "{{HOME}}/.orca/agent-hooks/claude-hook.cmd"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{HOME}}/.claude/hooks/gitnexus/gitnexus-hook.cjs\"",
            "timeout": 10,
            "statusMessage": "Enriching with GitNexus graph context..."
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '{{HOME}}/.orca/agent-hooks/claude-hook.cmd' ]; then '{{HOME}}/.orca/agent-hooks/claude-hook.cmd'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Program Files/nodejs/node.exe",
            "args": [
              "{{HOME}}/.claude/hooks/gitnexus/gitnexus-hook.cjs"
            ],
            "timeout": 10,
            "statusMessage": "Checking GitNexus index freshness..."
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\WINDOWS\\System32\\cmd.exe",
            "args": [
              "/d",
              "/c",
              "{{HOME}}/.orca/agent-hooks/claude-hook.cmd"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{HOME}}/.claude/hooks/gitnexus/gitnexus-hook.cjs\"",
            "timeout": 10,
            "statusMessage": "Checking GitNexus index freshness..."
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '{{HOME}}/.orca/agent-hooks/claude-hook.cmd' ]; then '{{HOME}}/.orca/agent-hooks/claude-hook.cmd'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\WINDOWS\\System32\\cmd.exe",
            "args": [
              "/d",
              "/c",
              "{{HOME}}/.orca/agent-hooks/claude-hook.cmd"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '{{HOME}}/.orca/agent-hooks/claude-hook.cmd' ]; then '{{HOME}}/.orca/agent-hooks/claude-hook.cmd'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\WINDOWS\\System32\\cmd.exe",
            "args": [
              "/d",
              "/c",
              "{{HOME}}/.orca/agent-hooks/claude-hook.cmd"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '{{HOME}}/.orca/agent-hooks/claude-hook.cmd' ]; then '{{HOME}}/.orca/agent-hooks/claude-hook.cmd'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\WINDOWS\\System32\\cmd.exe",
            "args": [
              "/d",
              "/c",
              "{{HOME}}/.orca/agent-hooks/claude-hook.cmd"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '{{HOME}}/.orca/agent-hooks/claude-hook.cmd' ]; then '{{HOME}}/.orca/agent-hooks/claude-hook.cmd'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\WINDOWS\\System32\\cmd.exe",
            "args": [
              "/d",
              "/c",
              "{{HOME}}/.orca/agent-hooks/claude-hook.cmd"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '{{HOME}}/.orca/agent-hooks/claude-hook.cmd' ]; then '{{HOME}}/.orca/agent-hooks/claude-hook.cmd'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '{{HOME}}/.orca/agent-hooks/claude-hook.cmd' ]; then '{{HOME}}/.orca/agent-hooks/claude-hook.cmd'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '{{HOME}}/.orca/agent-hooks/claude-hook.cmd' ]; then '{{HOME}}/.orca/agent-hooks/claude-hook.cmd'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '{{HOME}}/.orca/agent-hooks/claude-hook.cmd' ]; then '{{HOME}}/.orca/agent-hooks/claude-hook.cmd'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "node {{HOME}}/.claude/statusline.js"
  },
